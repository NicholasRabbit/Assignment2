<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LiveStockManagement.Pages.EditDataPage"
             xmlns:pages="clr-namespace:LiveStockManagement.Pages"
             x:DataType="pages:EditDataPage"
             Title="EditDataPage">
    <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
    <Picker x:Name="AnimalPicker" Title="Select Animal type" ItemsSource="{Binding AnimalTypes, Mode=OneTime}"/>
    
    <Button Clicked="Add" HeightRequest="10" Text="Add Dummy"/>
</VerticalStackLayout>
</ContentPage>